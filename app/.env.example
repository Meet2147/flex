# Public address of this service, no trailing slash. Used in checkout return links.
BASE_URL=http://localhost:4400
PORT=4400
# Where orders and generated pages are stored. Point this at a persistent disk in production.
DATA_DIR=./data

# Polar. Leave the token empty locally and checkout is replaced by a "simulate payment" page.
# With a token set, `node --env-file=app/.env app/scripts/polar-setup.mjs --write-env` creates the product and fills in its id.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
# Optional. Without it an order is confirmed when the buyer returns from checkout.
POLAR_WEBHOOK_SECRET=
# true = sandbox-api.polar.sh, anything else = the live API
POLAR_SANDBOX=

# Shown on the terms, refunds and privacy pages. Set all three before going live.
OPERATOR_NAME=Dashovia Innovations
OPERATOR_LOCATION=
SUPPORT_EMAIL=

# Claude writes the page copy. Leave empty to fall back to each site's own title and description.
ANTHROPIC_API_KEY=
FLEX_MODEL=claude-opus-5-5
